{
  "name": "nobs-recorder",
  "version": "0.1.0",
  "main": "main.js",
  "type": "commonjs",
  "scripts": {
    "vendor": "node scripts/vendor-mediapipe.js",
    "postinstall": "node scripts/vendor-mediapipe.js",
    "start": "node scripts/vendor-mediapipe.js && electron .",
    "pack": "node scripts/vendor-mediapipe.js && electron-builder --dir",
    "dist": "node scripts/vendor-mediapipe.js && electron-builder",
    "dist:win": "node scripts/vendor-mediapipe.js && electron-builder --win",
    "dist:linux": "node scripts/vendor-mediapipe.js && electron-builder --linux"
  },
  "devDependencies": {
    "@mediapipe/tasks-vision": "^1.1.1",
    "electron": "^39.2.7",
    "electron-builder": "^26.15.3"
  },
  "keywords": [],
  "author": "EdwardAThomson",
  "license": "ISC",
  "description": "A minimal, reliable desktop screen recorder.",
  "build": {
    "appId": "com.edwardathomson.nobs-recorder",
    "productName": "NoBS Recorder",
    "directories": {
      "output": "dist",
      "buildResources": "build-resources"
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "NoBS Recorder"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "AudioVideo",
      "synopsis": "Minimal desktop screen recorder"
    }
  }
}
